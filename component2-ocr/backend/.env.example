# Copy to backend/.env and fill in. Never commit .env.

# OCR: "crnn" (our trained model, models/crnn_best.pt + models/charset.json, CPU),
#      "google" (Cloud Vision) or "tesseract" (offline baseline)
OCR_ENGINE=crnn
# Leave empty to fail instead of silently switching engines (keeps experiments clean)
OCR_FALLBACK_ENGINE=
# Only for OCR_ENGINE=google:
# GOOGLE_APPLICATION_CREDENTIALS=C:/keys/civicbook-vision.json
# Only for OCR_ENGINE=tesseract (if not on PATH):
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_LANG=sin+eng

# Correction: "full" (uncertainty-scoped edits + verifier) or "blind_rag" (LLM rewrites all lines, comparison only)
CORRECTION_MODE=full
# A word is uncertain (the only kind the LLM may change) if its lowest CRNN character confidence is below this
CORRECTION_TAU=0.8
# Seconds to wait after each LLM round (rate limit)
LLM_ROUND_PAUSE_S=1
RETRIEVAL_TOP_K=20

# LLM correction (Google AI Studio key). Without it the pipeline returns FALLBACK_RAW.
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Component 3 endpoint that receives the package. Empty = built-in mock.
COMPONENT3_URL=
